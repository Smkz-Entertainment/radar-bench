{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://radar-bench.dev/schema/benchmark-result-v1.2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "suite_id", "release_version", "status", "candidate_gold_visible", "candidate_repository_visible", "network_used", "blockers"],
  "properties": {
    "schema_version": {"const": "1.2-jsonl"},
    "suite_id": {"const": "decisive-v1.2"},
    "release_version": {"const": "1.1.0"},
    "status": {"enum": ["BLOCKED", "COMPLETED"]},
    "candidate_gold_visible": {"const": false},
    "candidate_repository_visible": {"const": false},
    "network_used": {"const": false},
    "episode_ids": {"type": "string"},
    "artifact_root": {"type": ["string", "null"]},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "candidate_bundle": {"type": "object"},
    "runtime": {"type": "object"},
    "information_sufficiency": {"type": "object"},
    "evaluator_bundle": {"type": "object"},
    "protocol": {"type": "object"},
    "protocol_result": {"type": "object"},
    "runs": {"type": "object"},
    "episode_count": {"type": "integer"},
    "mapping_digest": {"$ref": "#/$defs/digest"},
    "metrics": {"$ref": "#/$defs/metrics"},
    "candidate_bundle_digest": {"$ref": "#/$defs/digest"},
    "evaluator_bundle_digest": {"$ref": "#/$defs/digest"},
    "runtime_digest": {"$ref": "#/$defs/digest"},
    "artifact_catalog_digest": {"$ref": "#/$defs/digest"},
    "baseline_digests": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/digest"}},
    "protocol_version": {"const": "1.2-jsonl"},
    "executor_capability_version": {"type": "string", "minLength": 1},
    "platform_contract": {"type": "object", "additionalProperties": false, "required": ["os", "architecture", "runtime", "network"], "properties": {"os": {"type": "string"}, "architecture": {"type": "string"}, "runtime": {"type": "string"}, "network": {"const": "none"}}},
    "isolation_verification": {"type": "object", "additionalProperties": false, "required": ["candidate_gold_hidden", "candidate_repository_hidden", "network_denied", "cleanup_verified"], "properties": {"candidate_gold_hidden": {"const": true}, "candidate_repository_hidden": {"const": true}, "network_denied": {"const": true}, "cleanup_verified": {"const": true}}},
    "experiment_receipts": {"type": "object"},
    "predictions": {"type": "object"},
    "source_provenance": {"type": "object", "additionalProperties": false, "required": ["suite", "candidate_bundle", "evaluator_bundle", "runtime", "artifact_catalog", "baseline"], "properties": {"suite": {"$ref": "#/$defs/digest"}, "candidate_bundle": {"$ref": "#/$defs/digest"}, "evaluator_bundle": {"$ref": "#/$defs/digest"}, "runtime": {"$ref": "#/$defs/digest"}, "artifact_catalog": {"$ref": "#/$defs/digest"}, "baseline": {"$ref": "#/$defs/digest"}}},
    "cleanup_status": {"type": "object", "additionalProperties": false, "required": ["candidate_container", "experiment_containers", "preparation_volumes", "errors"], "properties": {"candidate_container": {"const": "VERIFIED"}, "experiment_containers": {"const": "VERIFIED"}, "preparation_volumes": {"const": "VERIFIED"}, "errors": {"type": "array", "maxItems": 0}}},
    "decision": {"type": "string", "minLength": 1},
    "scientific_classification": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "metric": {"type": "object", "additionalProperties": false, "required": ["value", "numerator", "denominator", "status"], "properties": {"value": {"type": ["number", "null"]}, "numerator": {"type": "integer"}, "denominator": {"type": "integer"}, "status": {"enum": ["evaluable", "not_evaluable"]}}},
    "metrics": {"type": "object", "additionalProperties": false, "required": ["historical_attribution_resolution", "historical_correct_abstention", "semantic_ambiguity_handling", "candidate_induced_correctness", "root_cause_component_correctness", "action_owner_correctness", "cross_repository_resolution", "safety_abstention_recall", "false_owner_accusation_rate", "fresh_useful_experiment_rate", "requested_experiment_efficiency"], "properties": {"historical_attribution_resolution": {"$ref": "#/$defs/metric"}, "historical_correct_abstention": {"$ref": "#/$defs/metric"}, "semantic_ambiguity_handling": {"$ref": "#/$defs/metric"}, "candidate_induced_correctness": {"$ref": "#/$defs/metric"}, "root_cause_component_correctness": {"$ref": "#/$defs/metric"}, "action_owner_correctness": {"$ref": "#/$defs/metric"}, "cross_repository_resolution": {"$ref": "#/$defs/metric"}, "safety_abstention_recall": {"$ref": "#/$defs/metric"}, "false_owner_accusation_rate": {"$ref": "#/$defs/metric"}, "fresh_useful_experiment_rate": {"$ref": "#/$defs/metric"}, "requested_experiment_efficiency": {"$ref": "#/$defs/metric"}}}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "COMPLETED"}}}, "then": {"required": ["candidate_bundle_digest", "evaluator_bundle_digest", "runtime_digest", "artifact_catalog_digest", "baseline_digests", "protocol_version", "executor_capability_version", "platform_contract", "isolation_verification", "experiment_receipts", "predictions", "source_provenance", "cleanup_status", "decision", "scientific_classification", "runs", "episode_count", "mapping_digest", "metrics"], "properties": {"blockers": {"maxItems": 0}, "episode_count": {"const": 25}}}}
  ]
}
