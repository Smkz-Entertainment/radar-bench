  "properties": {"schema_version": {"const": "1.2-jsonl"}, "suite_id": {"const": "decisive-v1.2"}, "status": {"enum": ["BLOCKED", "COMPLETED"]}, "candidate_gold_visible": {"const": false}, "candidate_repository_visible": {"const": false}, "network_used": {"const": false}, "blockers": {"type": "array", "items": {"type": "string"}}, "metrics": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["value", "numerator", "denominator", "status"], "properties": {"value": {"type": ["number", "null"]}, "numerator": {"type": "integer"}, "denominator": {"type": "integer"}, "status": {"enum": ["evaluable", "not_evaluable"]}}}}}
}
