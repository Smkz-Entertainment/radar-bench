{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ecosystem-radar/gold-admission-v0.3.schema.json",
  "title": "Radar Gold Admission v0.3",
  "description": "Fail-closed record for attribution gold and safety/abstention cases.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "admission_id", "case_id", "corpus_kind", "candidate_category", "difficulty", "negative_control", "counterfactual", "derived_from_positive_case_id", "admission_state", "target_split", "source_cutoff", "source_urls", "independent_evidence", "candidate_snapshot", "gold_packet", "gold_derivation", "gold_label", "audit"],
  "properties": {
    "schema_version": {"const": "0.3"},
    "admission_id": {"type": "string", "pattern": "^ADMIT-V03-[A-Z0-9._:-]+$"},
    "case_id": {"type": "string", "pattern": "^RADAR-V03-[A-Z0-9._:-]+$"},
    "corpus_kind": {"enum": ["attribution_gold", "safety_abstention"]},
    "candidate_category": {"enum": ["true_upstream_regression", "expected_breaking_change", "downstream_incompatibility", "dependency_transitive_failure", "packaging_build_failure", "resolver_failure", "cross_repo_system_failure", "negative_control", "confounded_change", "flaky_nondeterministic", "infrastructure_failure", "baseline_broken", "duplicate", "artifact_missing", "resolver_confounded", "unsafe_to_attribute", "counterfactual_variant"]},
    "difficulty": {"enum": ["D1", "D2", "D3", "D4", "D5"]},
    "negative_control": {"type": "boolean"},
    "negative_control_type": {"enum": ["none", "confounded", "flaky", "infrastructure", "baseline_broken", "duplicate", "artifact_missing", "resolver_confounded", "unsafe_to_attribute", "counterfactual"]},
    "counterfactual": {"type": "boolean"},
    "derived_from_positive_case_id": {"type": ["string", "null"], "pattern": "^RADAR-V03-[A-Z0-9._:-]+$"},
    "admission_state": {"enum": ["planned", "collected", "candidate", "admitted", "rejected", "blocked"]},
    "target_split": {"enum": ["development", "validation", "hidden_test"]},
    "source_cutoff": {"type": "string", "format": "date-time"},
    "source_urls": {"type": "array", "items": {"type": "string", "format": "uri"}, "uniqueItems": true},
    "independent_evidence": {"type": "array", "maxItems": 50, "items": {"type": "object", "additionalProperties": false, "required": ["evidence_id", "kind", "uri", "published_at", "available_after_cutoff", "role", "snapshot_digest"], "properties": {"evidence_id": {"type": "string", "pattern": "^G03-[A-Z0-9._:-]+$"}, "kind": {"enum": ["maintainer_confirmation", "upstream_confirmation", "first_bad_version", "first_bad_commit", "causal_intervention", "minimized_reproducer", "linked_fix", "revert", "post_fix_recovery", "issue", "pull_request", "commit", "workflow_run", "release", "other"]}, "uri": {"type": "string", "format": "uri"}, "published_at": {"type": "string", "format": "date-time"}, "available_after_cutoff": {"type": "boolean"}, "role": {"enum": ["maintainer_confirmation", "first_bad", "causal", "reproducer", "resolution", "post_fix", "context"]}, "snapshot_digest": {"type": ["string", "null"], "pattern": "^(sha256:[0-9a-f]{64})?$"}, "notes": {"type": ["string", "null"], "maxLength": 2000}}}},
    "candidate_snapshot": {"type": "object", "additionalProperties": false, "required": ["path", "digest", "cutoff_only"], "properties": {"path": {"type": ["string", "null"]}, "digest": {"type": ["string", "null"], "pattern": "^(sha256:[0-9a-f]{64})?$"}, "cutoff_only": {"type": "boolean"}}},
    "gold_packet": {"type": "object", "additionalProperties": false, "required": ["path", "digest", "post_cutoff_only", "scorer_only"], "properties": {"path": {"type": ["string", "null"]}, "digest": {"type": ["string", "null"], "pattern": "^(sha256:[0-9a-f]{64})?$"}, "post_cutoff_only": {"type": "boolean"}, "scorer_only": {"type": "boolean"}}},
    "gold_derivation": {"enum": ["not_started", "independent_public_evidence", "insufficient_evidence", "retracted"]},
    "gold_label": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["should_abstain", "candidate_induced", "trigger_component", "trigger_change", "manifestation_project", "manifestation_layer", "root_cause_component", "root_cause_mechanism", "action_owner_repository", "first_bad_version_or_revision", "confounders", "evidence_class"], "properties": {"should_abstain": {"type": "boolean"}, "candidate_induced": {"type": ["boolean", "null"]}, "trigger_component": {"type": ["string", "null"]}, "trigger_change": {"type": ["string", "null"]}, "manifestation_project": {"type": ["string", "null"]}, "manifestation_layer": {"type": ["string", "null"]}, "root_cause_component": {"type": ["string", "null"]}, "root_cause_mechanism": {"type": ["string", "null"]}, "action_owner_repository": {"type": ["string", "null"], "format": "uri"}, "first_bad_version_or_revision": {"type": ["string", "null"]}, "confounders": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "evidence_class": {"enum": ["OBSERVED", "REPRODUCED", "CANDIDATE_SPECIFIC", "CONFOUNDED", "CAUSALLY_SUPPORTED", "CONFIRMED"]}}}]},
    "audit": {"type": "object", "additionalProperties": false, "required": ["created_at", "last_reviewed_at", "derived_by", "review_status", "record_digest"], "properties": {"created_at": {"type": "string", "format": "date-time"}, "last_reviewed_at": {"type": "string", "format": "date-time"}, "derived_by": {"enum": ["osint_protocol", "human_review", "imported"]}, "review_status": {"enum": ["unreviewed", "independently_reviewed", "rejected", "retracted"]}, "reviewer": {"type": ["string", "null"]}, "record_digest": {"type": ["string", "null"], "pattern": "^(sha256:[0-9a-f]{64})?$"}}}
  }
}
