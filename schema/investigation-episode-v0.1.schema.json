{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ecosystem-radar/investigation-episode-v0.1.schema.json",
  "title": "Radar InvestigationEpisode v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "episode_id", "case_id", "corpus_kind", "difficulty", "t0", "tcut", "candidate_snapshot", "hidden_gold_packet", "observed_facts", "plausible_components", "action_space", "experiment_budget", "historical_evidence", "gold", "terminal", "provenance"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "episode_id": {"type": "string", "pattern": "^RADAR-V05-E-[A-Z0-9._:-]+$"},
    "case_id": {"type": "string", "minLength": 3},
    "corpus_kind": {"enum": ["attribution", "safety"]},
    "difficulty": {"enum": ["D1", "D2", "D3", "D4", "D5"]},
    "t0": {"type": "string", "format": "date-time"},
    "tcut": {"type": "string", "format": "date-time"},
    "candidate_snapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "digest", "cutoff_only", "visible_evidence_ids"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "cutoff_only": {"const": true},
        "visible_evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "hidden_gold_packet": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "digest", "post_cutoff_only", "scorer_only", "evidence_ids"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "post_cutoff_only": {"const": true},
        "scorer_only": {"const": true},
        "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "observed_facts": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["fact_id", "text", "evidence_ids"],
        "properties": {
          "fact_id": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1, "maxLength": 2000},
          "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        }
      }
    },
    "plausible_components": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["component_id", "kind", "initial_status"],
        "properties": {
          "component_id": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "initial_status": {"enum": ["plausible", "weak", "not_supported"]}
        }
      }
    },
    "action_space": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "experiment_budget": {
      "type": "object", "additionalProperties": false,
      "required": ["max_substantive", "max_reruns"],
      "properties": {
        "max_substantive": {"const": 5},
        "max_reruns": {"type": "integer", "minimum": 0, "maximum": 2}
      }
    },
    "historical_evidence": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["evidence_id", "role", "published_at", "available_after_cutoff", "immutable_source", "snapshot_digest", "uri"],
        "properties": {
          "evidence_id": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1},
          "published_at": {"type": "string", "format": "date-time"},
          "available_after_cutoff": {"type": "boolean"},
          "immutable_source": {"type": "boolean"},
          "snapshot_digest": {"type": ["string", "null"]},
          "uri": {"type": "string", "format": "uri"}
        }
      }
    },
    "gold": {
      "type": "object", "additionalProperties": false,
      "required": ["attributability_class", "justification", "source_evidence_ids", "candidate_induced", "should_abstain", "action_owner_scored", "root_cause_component", "action_owner_repository", "first_bad"],
      "properties": {
        "attributability_class": {"enum": ["STATICALLY_ATTRIBUTABLE", "EXPERIMENTALLY_ATTRIBUTABLE", "EXTERNALLY_DEPENDENT", "UNATTRIBUTABLE"]},
        "justification": {"type": "string", "minLength": 1},
        "source_evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "candidate_induced": {"type": ["boolean", "null"]},
        "should_abstain": {"type": "boolean"},
        "action_owner_scored": {"type": "boolean"},
        "root_cause_component": {"type": ["string", "null"]},
        "action_owner_repository": {"type": ["string", "null"]},
        "first_bad": {"type": ["string", "null"]}
      }
    },
    "terminal": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_induced", "root_cause_component", "action_owner_repository", "first_bad", "mitigation"],
      "properties": {
        "candidate_induced": {"type": ["boolean", "null"]},
        "root_cause_component": {"type": ["string", "null"]},
        "action_owner_repository": {"type": ["string", "null"]},
        "first_bad": {"type": ["string", "null"]},
        "mitigation": {"type": ["string", "null"]}
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["historical_basis", "independent_source_ids", "corpus_record_digest", "episode_digest"],
      "properties": {
        "historical_basis": {"type": "string", "minLength": 1},
        "independent_source_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "corpus_record_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "episode_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    }
  }
}
