{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ecosystem-radar/blind-run-v0.3.schema.json",
  "title": "Radar Blind Run v0.3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "candidate_snapshot_digest", "gold_packet_digest", "network_policy", "candidate_allowed_root", "gold_readable_by_candidate", "candidate_output_digest", "scorer_process", "implementation_commit", "environment_digest"],
  "properties": {
    "schema_version": {"const": "0.3"},
    "run_id": {"type": "string", "pattern": "^BLIND-V03-[A-Z0-9._:-]+$"},
    "candidate_snapshot_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "gold_packet_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "network_policy": {"const": "denied"},
    "candidate_allowed_root": {"type": "string", "minLength": 1},
    "gold_readable_by_candidate": {"const": false},
    "candidate_output_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "scorer_process": {"const": "separate_post_cutoff_process"},
    "implementation_commit": {"type": "string", "minLength": 7},
    "environment_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
