{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://radar-bench.dev/schema/candidate-episode-start-v1.2.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "message", "episode_id", "candidate_evidence", "capabilities", "budget"],
  "properties": {"schema_version": {"const": "1.2-jsonl"}, "message": {"const": "episode_start"}, "episode_id": {"type": "string", "minLength": 8}, "candidate_evidence": {"$ref": "candidate-evidence-v1.2.schema.json"}, "capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "budget": {"type": "object", "additionalProperties": false, "required": ["max_experiments"], "properties": {"max_experiments": {"type": "integer", "minimum": 0, "maximum": 10}}}}
}
