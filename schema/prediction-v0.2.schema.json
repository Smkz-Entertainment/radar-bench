{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ecosystem-radar/prediction-v0.2.schema.json",
  "title": "Radar Prediction v0.2",
  "description": "Versioned attribution output with abstention, evidence class, calibration, and usage accounting.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "verdict", "candidate_induced", "responsible_layer", "owner_repository", "owner_project", "owner_candidates", "intentionality", "first_bad", "confidence", "confidence_score", "evidence_classes", "rationale", "evidence_ids", "recommended_next_experiment", "provider", "provider_version", "created_at", "experiments_requested", "experiments_useful", "usage"],
  "properties": {
    "schema_version": {"const": "0.2"},
    "case_id": {"type": "string", "minLength": 3},
    "verdict": {"enum": ["confirmed_regression", "not_candidate_induced", "confounded_change", "inconclusive"]},
    "candidate_induced": {"type": ["boolean", "null"]},
    "responsible_layer": {"enum": ["upstream_runtime_or_library", "shared_dependency", "downstream_project", "dependency_resolution", "packaging_or_artifact", "external_service_or_data", "ci_or_infrastructure", "flaky_or_nondeterministic", "multiple_layers", "unknown"]},
    "owner_repository": {"type": ["string", "null"], "format": "uri"},
    "owner_project": {"type": ["string", "null"]},
    "owner_candidates": {"type": "array", "maxItems": 20, "items": {"type": "object", "additionalProperties": false, "required": ["rank", "repository", "project", "evidence_ids"], "properties": {"rank": {"type": "integer", "minimum": 1}, "repository": {"type": ["string", "null"], "format": "uri"}, "project": {"type": ["string", "null"]}, "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}}}},
    "intentionality": {"enum": ["expected_break", "unexpected_regression", "unknown", "not_applicable"]},
    "first_bad": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["kind", "value"], "properties": {"kind": {"enum": ["version", "revision", "pull_request", "range", "exact"]}, "value": {"type": "string", "minLength": 1}}}]},
    "confidence": {"enum": ["confirmed", "high", "medium", "low", "inconclusive"]},
    "confidence_score": {"type": "number", "minimum": 0, "maximum": 1},
    "evidence_classes": {"type": "array", "minItems": 1, "items": {"enum": ["OBSERVED", "REPRODUCED", "CAUSALLY_SUPPORTED", "CONFIRMED"]}, "uniqueItems": true},
    "rationale": {"type": "string", "minLength": 1, "maxLength": 8000},
    "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "recommended_next_experiment": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["kind", "question"], "properties": {"kind": {"enum": ["ab", "pin", "bisect", "repeat", "network_check", "inspect", "other"]}, "question": {"type": "string", "minLength": 1}, "commands": {"type": "array", "items": {"type": "array", "items": {"type": "string"}}}}}]},
    "provider": {"enum": ["deterministic", "local_model", "codex", "imported"]},
    "provider_version": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "experiments_requested": {"type": "integer", "minimum": 0},
    "experiments_useful": {"type": "integer", "minimum": 0},
    "usage": {"type": "object", "additionalProperties": false, "required": ["input_tokens", "output_tokens", "amount", "currency", "wall_clock_seconds"], "properties": {"input_tokens": {"type": ["integer", "null"], "minimum": 0}, "output_tokens": {"type": ["integer", "null"], "minimum": 0}, "amount": {"type": ["number", "null"], "minimum": 0}, "currency": {"type": ["string", "null"]}, "wall_clock_seconds": {"type": ["number", "null"], "minimum": 0}}},
    "cost": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "properties": {"input_tokens": {"type": "integer", "minimum": 0}, "output_tokens": {"type": "integer", "minimum": 0}, "currency": {"type": "string"}, "amount": {"type": "number", "minimum": 0}, "wall_clock_seconds": {"type": "number", "minimum": 0}}}]}
  }
}
