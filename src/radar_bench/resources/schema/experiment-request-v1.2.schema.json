  "properties": {"schema_version": {"const": "1.2-jsonl"}, "message": {"const": "experiment_request"}, "episode_id": {"type": "string"}, "request_id": {"type": "string", "minLength": 1}, "capability": {"enum": ["rerun", "inspect_environment", "inspect_dependency_graph", "run_minimal_test", "change_dependency_version"]}, "parameters": {"type": "object", "additionalProperties": true}}
}
